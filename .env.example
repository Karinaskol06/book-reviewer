# Copy to `.env` for Docker Compose and/or local Spring Boot.
# Docker Compose reads .env automatically from the project root.

# Database
# - Inside Compose: DB_HOST=postgres, DB_PORT=5432
# - Spring runs on the host, not in Docker: DB_HOST=localhost, DB_PORT=5433
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bookreviewer
DB_USERNAME=bookreview_user
DB_PASSWORD=bookreview_password

# Server
# Host Spring Boot default in application.yaml is 8081.
# The app container listens on 8080 (mapped to host 8081).
SERVER_PORT=8081

# JWT (change before deploy)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION=86400000

# Local file uploads
UPLOAD_DIR=./uploads-book-reviewer
AVATAR_DIR=avatars

# Object storage: local (default) | s3 (planned AWS path)
STORAGE_TYPE=local
STORAGE_PUBLIC_BASE_URL=
AWS_S3_BUCKET=
AWS_S3_REGION=eu-central-1
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PATH_STYLE=false

# Elasticsearch
# - Host tools / local Spring Boot: localhost
# - App container (set by docker-compose): elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# Logging
LOG_LEVEL=INFO
JPA_SHOW_SQL=false
