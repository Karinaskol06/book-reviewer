# Compose Postgres (aws-lite): DB_HOST=postgres
# Amazon RDS (aws-rds): DB_HOST=your-db.xxxx.eu-central-1.rds.amazonaws.com
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bookreviewer
DB_USERNAME=bookreview_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRATION=86400000

SPRING_PROFILES_ACTIVE=docker,no-es
ELASTICSEARCH_ENABLED=false
LOG_LEVEL=INFO

# local | s3
STORAGE_TYPE=s3
AWS_S3_BUCKET=bookreviewer-avatars
AWS_S3_REGION=eu-central-1
# Public object base
STORAGE_PUBLIC_BASE_URL=https://your-bucket-name.s3.eu-central-1.amazonaws.com
