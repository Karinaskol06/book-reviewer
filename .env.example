# Database Configuration
# Docker Compose (profile full / containers): DB_HOST=postgres, DB_PORT=5432
# Host Spring Boot (recommended for feature work): DB_HOST=localhost, DB_PORT=5433
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bookreviewer
DB_USERNAME=bookreview_user
DB_PASSWORD=bookreview_password

# Server Configuration
# Host Spring Boot: use 8081 (8080 is often taken by other tools).
# Docker app container still listens on 8080 internally (mapped as 8081:8080).
SERVER_PORT=8081

# JWT Configuration
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Upload directory
UPLOAD_DIR=./uploads-book-reviewer
AVATAR_DIR=avatars

# Elasticsearch (host loop: localhost; docker app: elasticsearch)
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# Logging
LOG_LEVEL=INFO
JPA_SHOW_SQL=false
